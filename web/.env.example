# MedLink SA web: example environment. Copy to web/.env and fill in your own values.
# Placeholders only. NEVER commit real credentials; .env and .env*.local are git-ignored.

# Pooled connection (Supabase connection pooler, transaction mode, port 6543). Used at runtime.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (Supabase connection pooler, session mode, port 5432). Used by Prisma Migrate.
# Alternative: the direct connection, postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Supabase project (planned; not read by the app yet).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never send to the browser or ship in the Android app.
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"
